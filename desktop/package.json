{
  "name": "nadir-shop-gestion",
  "productName": "Nadir Shop Gestion",
  "version": "1.0.0",
  "description": "Application de gestion de la boutique Nadir Shop (produits, stock, commandes)",
  "author": "Nadir Shop",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --arm64 --x64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.nadirshop.gestion",
    "productName": "Nadir Shop Gestion",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "app/**", "build/icon.png"],
    "afterPack": "./signer-adhoc.js",
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }]
    },
    "dmg": {
      "title": "Nadir Shop Gestion",
      "artifactName": "Nadir-Shop-Gestion-${version}-mac-${arch}.${ext}",
      "contents": [{ "x": 140, "y": 190, "type": "file" }, { "x": 400, "y": 190, "type": "link", "path": "/Applications" }],
      "window": { "width": 540, "height": 380 }
    },
    "win": {
      "icon": "build/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Nadir-Shop-Gestion-${version}-windows.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false, "createDesktopShortcut": true }
  }
}
